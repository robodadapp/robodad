# Copy this file to .env for local runs. Set ONE provider key.
# With no key at all, RoboDad runs in classic (classifier-only) mode.

# Option A: Groq (free tier)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BACKUP_MODELS=openai/gpt-oss-20b

# Option B: Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Option C: any OpenAI-compatible API
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Force a provider (auto | anthropic | groq | openai | none)
LLM_PROVIDER=auto

# Protection for a public site
RATE_LIMIT=30/600
DAILY_LLM_LIMIT=1500
LLM_MAX_TOKENS=400
LLM_TEMPERATURE=0.7

# Optional: save thumbs up/down to Supabase
SUPABASE_URL=
SUPABASE_KEY=

# Optional: RoboDad's male voices for French, Spanish and Hindi practice
# (Microsoft Azure Speech, free tier F0). Without a key, the phone's own voice is used.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=canadacentral
LANG_TTS_DAILY_CHARS=15000
